# ========== 大模型 API Key ==========
ARK_API_KEY=ark-ce8beb45-2fe2-4396-9abf-881197fe65c3-f3a50
ARK_ENDPOINT_ID=your_endpoint_id_here

# 备用模型列表
ALTERNATIVE_MODELS=zhipu:glm-4.7-flash,dashscope:qwen-plus

# ========== JWT & 认证 ==========
JWT_SECRET_KEY=change-me-to-a-random-string-64chars-minimum

# ========== 数据库 ==========
DATABASE_URL=sqlite:///./data/app.db

# ========== 运行环境 ==========
ENV=production
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_DAYS=30

# ========== CORS ==========
CORS_ORIGINS=https://yourdomain.com

# ========== HTTPS & 安全 ==========
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# ========== 管理员 ==========
ADMIN_TOKEN=change-me-to-a-secure-random-token
API_SECRET_KEY=change-me-to-a-secure-random-key

# ========== 安全功能开关 ==========
ENABLE_SENSITIVE_FILTER=true
ENABLE_RATE_LIMIT=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SQL_INJECTION_PROTECTION=true
ENABLE_CSP=true

# ========== LLM 配置 ==========
LLM_MOCK_MODE=false
DEBUG_PROMPT=false
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT=300
