# ========== LLM 大模型配置 ==========

# 千问（DashScope API）- 首选模型
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 千问模型名称（可选，默认 qwen-max，也可用 qwen-plus, qwen-turbo）
# QWEN_MODEL=qwen-max

# 火山方舟（豆包/Doubao / Ark API）- 次选模型
# 申请地址: https://console.volcengine.com/ark/
ARK_API_KEY=your_ark_api_key_here
ARK_ENDPOINT_ID=your_ark_endpoint_id_here

# DeepSeek - 备选模型
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型优先级（可选，逗号分隔，默认: qwen,doubao,deepseek）
# 例如只使用千问+DeepSeek: LLM_PRIORITY=qwen,deepseek
LLM_PRIORITY=qwen,doubao,deepseek

# JWT密钥（随机字符串，用于生成Token）
JWT_SECRET_KEY=your-random-jwt-secret-key-here-please-change-this

# 数据库连接地址
DATABASE_URL=sqlite:///./app.db

# ========== 安全功能开关 ==========

# 敏感词过滤开关（必须）
ENABLE_SENSITIVE_FILTER=true

# 限流开关（必须）
ENABLE_RATE_LIMIT=true

# ========== 阿里云内容安全API配置 ==========
# 文档参考：https://help.aliyun.com/document_detail/444323.html

# 是否启用阿里云内容安全API
ALIYUN_GREEN_ENABLE=false

# 阿里云AccessKey ID（从阿里云控制台获取）
ALIYUN_GREEN_ACCESS_KEY_ID=your_aliyun_access_key_id

# 阿里云AccessKey Secret（从阿里云控制台获取）
ALIYUN_GREEN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret

# ========== 自动封禁配置 ==========

# 是否启用自动封禁功能
AUTO_BAN_ENABLE=true

# 自动封禁阈值（1小时内触发拦截次数达到此值将自动封禁）
AUTO_BAN_THRESHOLD=10

# 统计窗口时间（小时）
AUTO_BAN_WINDOW_HOURS=1

# ========== Redis连接配置（可选）==========

# Redis 连接地址（用于分布式限流，可选）
REDIS_URL=redis://localhost:6379

# ========== LLM 调用配置 ==========

# LLM Mock 模式（已禁用，取消注释可启用调试模式）
# LLM_MOCK_MODE=true

# ========== 管理员配置 ==========

# 管理员Token（用于管理员API鉴权，必须修改）
ADMIN_TOKEN=your_secure_admin_token_change_me

# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码
ADMIN_PASSWORD=a.144iLil123

# API签名校验密钥（建议）
API_SECRET_KEY=your_api_secret_key_change_me

# ========== 调试配置 ==========

# 调试开关（可选，生产环境必须false）
DEBUG_PROMPT=false

# 跳过签名校验（仅开发环境）
SKIP_SIGNATURE_VERIFY=false
