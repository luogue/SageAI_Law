    "concepts": {
      "loan.bank_relending": {
        "kind": "boolean",
        "description": "文本肯定叙述出借资金源自金融机构贷款后转贷；禁止、否认或合法资金承诺是EXPLICIT_NONE，不代表外部事实已证实。",
        "multiple": false
      },
      "loan.unlicensed_repeated_lending": {
        "kind": "boolean",
        "description": "文本肯定叙述未取得放贷资格、为营利向不特定对象反复放贷的事实；否认或承诺不做此事是EXPLICIT_NONE。",
        "multiple": false
      },
      "loan.known_illegal_use": {
        "kind": "boolean",
        "description": "文本肯定叙述出借人明知违法犯罪用途仍出借；或明确本笔资金用于违法犯罪。禁止违法用途是EXPLICIT_NONE。",
        "multiple": false
      },
      "loan.upfront_deduction": {
        "kind": "boolean",
        "description": "实际约定从本金预扣利息或融资服务费。禁止预扣是EXPLICIT_NONE。",
        "multiple": false
      },
      "loan.financing_fee": {
        "kind": "boolean",
        "description": "实际收取融资服务费、管理费、咨询费等；不包括实现债权费用、一般违约金和不收取费用的约定。",
        "multiple": false
      },
      "loan.early_permission": {
        "kind": "boolean",
        "description": "合同是否允许借款人提前返还本金。明确禁止为PRESENT false并引用禁止原文。",
        "multiple": false
      },
      "loan.early_prohibited": {
        "kind": "boolean",
        "description": "绝对禁止提前还款的约定。",
        "multiple": false
      },
      "loan.early_charge": {
        "kind": "boolean",
        "description": "提前清偿需支付违约金、补偿金或手续费的肯定安排；免收是EXPLICIT_NONE，不评价高低。",
        "multiple": false
      },
      "loan.cost_components": {
        "kind": "loan_charge",
        "description": "逐一提取实际收取的借期利息、逾期利息、违约金、融资费用。全部免责或禁止不算收费。kind=regular_interest/overdue_interest/penalty/financing_fee; charge_key是同一收费的稳定名称；base=PRINCIPAL/UNPAID_INTEREST/UNKNOWN；scope=LOAN_TERM表示仅借期内，OVERDUE表示从逾期起算至清偿，UNTIL_REPAYMENT表示从放款起持续到清偿（包括借期及逾期），UNKNOWN表示起止不明。不能仅因出现“至清偿”就使用UNTIL_REPAYMENT。rate={state:PRESENT,percent:原始百分数,period:DAY/MONTH/YEAR/ONCE}；按一次违约收取本金百分比的period为ONCE，绝不年化或伪造日/月单位。相对借期利率使用{state:PRESENT,multiplier:倍数,reference:REGULAR_RATE}；无法确定的金额/公式使用{state:UNKNOWN}，未来另定用{state:DEFERRED}。不要猜本金基数，不要年化，不合并不同费用。",
        "multiple": true
      },
      "loan.cost_cumulative": {
        "kind": "boolean",
        "description": "明确约定逾期后借期利息和逾期责任继续叠加计收。",
        "multiple": false
      },
      "loan.cost_replacement": {
        "kind": "boolean",
        "description": "明确约定逾期责任替代借期利息，借期利息停止计收。",
        "multiple": false
      },
      "loan.cost_exclusive": {
        "kind": "boolean",
        "description": "逾期收费明确择一主张、不得同时计收。",
        "multiple": false
      }
    },
