      },
      {
        "clause_id": "C0015",
        "section": "3.1",
        "text": "3.1 甲乙双方因履行本合同发生纠纷，应首先协商解决；协商不成，则向青岛市黄岛区人民法院提起诉讼。",
        "section_type": "正式合同条款",
        "block_type": "OPERATIVE_CLAUSE",
        "source_start": 825,
        "source_end": 874
      },
      {
        "clause_id": "C0016",
        "section": "3.2",
        "text": "3.2 在诉讼期间，本合同不涉及争议部分的条款仍需履行。",
        "section_type": "正式合同条款",
        "block_type": "OPERATIVE_CLAUSE",
