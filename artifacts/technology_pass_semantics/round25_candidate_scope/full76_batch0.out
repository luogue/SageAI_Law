________ test_final_evidence_covers_each_cooperative_risk_proposition _________

cooperative_review = {'success': True, 'contract_type': 'technology', 'selected_contract_type': 'technology', 'domain_selection_resolution'..., 'contract_subtype': 'COOPERATIVE_DEVELOPMENT', ...}, 'compatibility': 'COMPATIBLE', 'resolution': 'AGREE', ...}, ...}

    def test_final_evidence_covers_each_cooperative_risk_proposition(cooperative_review: dict):
        findings = {row["risk_group"]: row for row in cooperative_review["risk_findings"]}
    
        liability = {
            row["fact_type"]: row["quoted_text"]
            for row in findings["asymmetric_breach_liability"]["evidence_bundle"]["items"]
        }
        assert "10涓囧厓" in liability["PARTY_A_COMPARABLE_LIABILITY"]
        assert "30涓囧厓" not in liability["PARTY_A_COMPARABLE_LIABILITY"]
        assert "30涓囧厓" in liability["PARTY_B_COMPARABLE_LIABILITY"]
        assert "10涓囧厓" not in liability["PARTY_B_COMPARABLE_LIABILITY"]
        assert "ratio=3" in liability["LIABILITY_RATIO_COMPARISON"]
    
        dispute = findings["dispute_resolution_choice_conflict"]["evidence_bundle"]["items"]
        assert any("鍗椾含浠茶濮斿憳浼? in row["quoted_text"] for row in dispute)
