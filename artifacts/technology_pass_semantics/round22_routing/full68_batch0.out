_______ test_renderer_uses_lineage_evidence_instead_of_keyword_fallback _______

gold_review = {'contract_type_flow': {'stages': {'request': 'technology', 'canonical': 'technology', 'facts_pipeline': 'technology',...ore_only': False, 'family_status': 'NOT_MIGRATED'}, 'structured_fact_debug': {}, 'employment_rule_adaptation': {}, ...}

    def test_renderer_uses_lineage_evidence_instead_of_keyword_fallback(gold_review):
        report = gold_review["result"]
    
        def item_section(item_id: str) -> str:
            marker = f"（{item_id}）"
            start = report.index(marker)
            end = report.find("\n---", start)
            return report[start:end if end >= 0 else None]
    
        timeline = item_section("TECH-SHARED-03")
