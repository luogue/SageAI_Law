_id": "technical_secret_confidentiality", "applicability_evaluator": "review_v2.engine._is_checkpoint_applicable", "coverage_evaluator": "review_v2.engine._judge_checkpoints_with_registry", "post_rule_evaluator": "review_v2.engine._apply_contract_specific_post_rules"}, "TC-11-02": {"checkpoint_type": "review_v2.house_lease_checklist.ReviewCheckpoint", "node_id": "confidentiality_period_and_scope", "applicability_evaluator": "review_v2.engine._is_checkpoint_applicable", "coverage_evaluator": "review_v2.engine._judge_checkpoints_with_registry", "post_rule_evaluator": "review_v2.engine._apply_contract_specific_post_rules"}, "TC-11-03": {"checkpoint_type": "review_v2.house_lease_checklist.ReviewCheckpoint", "node_id": "confidential_material_return_destroy", "applicability_evaluator": "review_v2.engine._is_checkpoint_applicable", "coverage_evaluator": "review_v2.engine._judge_checkpoints_with_registry", "post_rule_evaluator": "review_v2.engine._apply_contract_specific_post_rules"}, "TC-11-04": {"checkpoint_type": "review_v2.house_lease_checklist.ReviewCheckpoint", "node_id": "confidentiality_breach_liability", "applicability_evaluator": "review_v2.engine._is_checkpoint_applicable", "coverage_evaluator": "review_v2.engine._judge_checkpoints_with_registry", "post_rule_evaluator": "review_v2.engine._apply_contract_specific_post_rules"}, "TC-13-01": {"checkpoint_type": "review_v2.house_lease_checklist.ReviewCheckpoint", "node_id": "technical_material_attachment", "applicability_evaluator": "review_v2.engine._is_checkpoint_applicable", "coverage_evaluator": "review_v2.engine._judge_checkpoints_with_registry", "post_rule_evaluator": "review_v2.engine._apply_contract_specific_post_rules"}}}, "payment_risk_lifecycle": {"status": "FINAL_RISK", "coverage_dimension": {"review_id": "TC-04-02", "coverage_status": "不适用", "independent_from_payment_risk": true}, "events": [{"event": "[FACT]", "source_clauses": [{"clause_id": "C0001", "location": "全文", "text": "技术许可（技术秘密）合同\n合同编号：JM-XK-2026-1020\n项目名称：高功率动力电池热管理控制算法及标定参数技术秘密许可\n被许可人（买方）：江苏恒能新能源汽车科技有限公司\n许可人（卖方）：南京智控新能源技术有限公司\n签订时间：2026年10月20日\n签订地点：江苏省南京市\n有效期限：2026年10月10日至2034年10月9日\n技术许可（技术秘密）合同\n被许可人（买方）：江苏恒能新能源汽车科技有限公司\n住所地：江苏省苏州市工业园区星湖街328号\n法定代表人：张建国\n项目联系人：王海峰\n联系方式：13800001234\n通讯地址：江苏省苏州市工业园区星湖街328号\n电话：0512-88886666\n电子信箱：wanghaifeng@example.com\n许可人（卖方）：南京智控新能源技术有限公司\n住所地：江苏省南京市江宁区创新大道188号\n法定代表人：李明远\n项目联系人：陈志强\n联系方式：13900005678\n通讯地址：江苏省南京市江宁区创新大道188号\n电话：025-88889999\n电子信箱：chenzhiqiang@example.com\n本合同卖方以排他方式许可买方实施其所拥有的“高功率动力电池热管理控制算法及标定参数”技术秘密，买方取得该项技术秘密的实施许可并支付相应许可使用费。\n双方经过平等协商，在真实、充分表达各自意愿的基础上，根据《中华人民共和国民法典》的规定，达成如下协议。"}, {"clause_id": "C0014", "location": "第三条第1项", "text": "1．提交时间：\n买方支付第一期费用后10个工作日内交付主要资料，其余资料根据项目进度陆续交付。"}, {"clause_id": "C0026", "location": "第六条第2项", "text": "2．律师费、诉讼费、鉴定费、和解费、赔偿费、产品召回费用及停产损失均由买方承担；"}, {"clause_id": "C0028", "location": "第六条第4项", "text": "4．即使侵权直接来源于卖方提供的技术秘密或技术资料，卖方承担的全部赔偿责任最高不超过买方已经实际支付技术秘密许可使用费的20%。"}, {"clause_id": "C0034", "location": "第八条第4项", "text": "4．泄密责任：\n买方违反保密义务的，应向卖方支付人民币5,000,000元违约金。\n如违约金不足以弥补卖方损失，买方还应继续赔偿全部损失。\n卖方"}, {"clause_id": "C0045", "location": "第十一条第2项", "text": "2．买方采用分期方式支付："}, {"clause_id": "C0046", "location": "第十一条（1）", "text": "（1）合同签订后5个工作日内支付50%，即人民币1,200,000元；"}, {"clause_id": "C0047", "location": "第十一条（2）", "text": "（2）主要技术资料交付后5个工作日内支付40%，即人民币960,000元；"}, {"clause_id": "C0048", "location": "第十一条（3）", "text": "（3）项目最终验收后5个工作日内支付30%，即人民币720,000元。\n除上述固定费用外，买方还应按照使用本项技术秘密生产产品年度净销售额的3%向卖方支付技术秘密许可提成。\n提成义务持续至本合同终止。\n合同终止后，对于合同有效期内已经生产但尚未销售的产品，买方销售时仍应按照3%支付提成。"}, {"clause_id": "C0053", "location": "第十二条第3项", "text": "3．买方应在卖方提交验收材料后5个工作日内完成验收。\n买方未在5个工作日内提出书面异议的，视为全部验收合格。\n具体测试环境、测试数据、性能指标、样本选择及测试方法由卖方确定。\n卖方可以根据项目实际情况调整测试条件和验收方法。\n无论最终产品商业化效果是否达到买方预期，均不影响买方支付全部许可费和技术服务费。"}, {"clause_id": "C0055", "location": "第十三条第1项", "text": "1．买方已经支付的费用不予返还；"}, {"clause_id": "C0056", "location": "第十三条第2项", "text": "2．尚未支付的固定许可费仍应继续支付；"}, {"clause_id": "C0065", "location": "第十五条第2项", "text": "2．卖方对本项技术秘密进行后续改进形成的成果归卖方所有。\n卖方可以自行使用或者许可任何第三方使用，无须取得买方同意。\n买方如需使用卖方后续改进成果，应另行支付许可费用。"}, {"clause_id": "C0072", "location": "第十七条第1项", "text": "1．卖方逾期交付主要技术资料的，每逾期一周，按照买方已经支付许可费的0.1%支付违约金。\n卖方累计承担的全部违约、赔偿及其他责任不超过买方已经实际支付许可费的20%。\n上述责任限制即使卖方存在重大过失仍然适用。"}, {"clause_id": "C0073", "location": "第十七条第2项", "text": "2．买方逾期付款的，每逾期一日，按照应付款金额的0.5%支付违约金。"}, {"clause_id": "C0075", "location": "第十七条第4项", "text": "4．买方违反保密义务的，应支付人民币5,000,000元违约金；不足以弥补损失的，应继续赔偿。"}, {"clause_id": "C0076", "location": "第十七条第5项", "text": "5．买方违反改进成果归属条款的，应无偿将相关成果转让给卖方，并按照本合同固定总价款的100%支付违约金。"}, {"clause_id": "C0081", "location": "第十九条第3项", "text": "3．买方违反付款、保密、许可范围或者改进成果归属义务；"}, {"clause_id": "C0082", "location": "第十九条第4项", "text": "4．卖方认为继续履行合同已经无法实现预期商业目的。\n因买方原因解除合同的，已付款不予返还，尚未支付的固定许可费仍应继续支付。\n因不可抗力解除合同的，已经支付的费用原则上不予返还。"}], "structured_total": 2400000, "structured_percentages": [50, 40, 30], "structured_amounts": [1200000, 960000, 720000]}, {"event": "[RULE_EXECUTED]", "source_rule": "analyze_payment_schedule", "invocation_count": 4, "call_sites": [{"module": "review_v2.technology_service_analysis", "function": "analyze_technology_relationship_risks", "line": 4944, "invocation_count": 2}, {"module": "review_v2.engine", "function": "_apply_technology_relationship_risk_layer", "line": 21214, "invocation_count": 1}, {"module": "review_v2.engine", "function": "_review_contract_v2_legacy", "line": 51647, "invocation_count": 1}], "input_document_hash": "4b4e77d54022087375751a441dd8d3113b40a3fb5eb81c1f006bfe57322f16c0", "output": {"status": "INCONSISTENT", "contract_total": 2400000, "contract_total_candidates": [{"value": 2400000, "label": "许可使用费总额", "currency": "CNY", "certainty": "explicit", "raw_text": "许可使用费总额：\n人民币2,400,000元", "start_offset": 2635, "end_offset": 2657, "source_document": "4b4e77d54022087375751a441dd8d3113b40a3fb5eb81c1f006bfe57322f16c0"}], "percentage_total": 120, "amount_total": 2880000, "amount_delta": 480000, "percentage_total_complete": true, "amount_total_complete": true, "nodes": [{"fact_id": "PAY-001-4ebf564c95"